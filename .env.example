# Copie para .env.local e preencha. O .env.local nao vai para o git.
#
# Na Vercel so a DATABASE_URL precisa existir (Settings -> Environment
# Variables). E a mesma do painel-turne-mdv: as tabelas desta ferramenta
# comecam com "conteudo_" e nao encostam nas do painel.

# Postgres do Neon - use a string COM "-pooler" no host: funcoes serverless
# abrem conexao a cada chamada e sem o pooler o limite estoura.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.neon.tech/neondb?sslmode=require"
